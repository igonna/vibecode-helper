{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:8767/prompt_started >/dev/null",
            "timeout": 5,
            "statusMessage": "Prompt started"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:8767/permission_asked >/dev/null",
            "timeout": 5,
            "statusMessage": "Permission asked"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:8767/prompt_finished >/dev/null",
            "timeout": 5,
            "statusMessage": "Prompt finished"
          }
        ]
      }
    ]
  }
}
